# Spring Boot no carga ".env" con un loader tipo dotenv por defecto -- estas
# variables hay que exportarlas al entorno (o pasarlas con -D) para correr el
# servicio suelto sin Docker. Al correr vía docker-compose/Kubernetes ya se
# inyectan por environment/Secret, este archivo es solo referencia.

# ===== Base de datos: Supabase (ver ../../.env.example en la raíz) =====
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:5432/zonas_db
SPRING_DATASOURCE_USERNAME=postgres.wxjxviqtqyrzflxaidur
SPRING_DATASOURCE_PASSWORD=reemplaza-esto-por-el-password-real-de-supabase
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_PROFILES_ACTIVE=docker

# ===== RabbitMQ (auditoría) =====
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
AUDIT_RABBITMQ_EXCHANGE=audit_exchange
AUDIT_RABBITMQ_ROUTING_KEY=audit.event

# Mismo secreto compartido por los 6 microservicios -- ver docker-compose.yml
JWT_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio-min-32-bytes

# ===== Swagger/OpenAPI =====
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
