# Copiar como ".env" para correr este servicio suelto (npm run start:dev),
# sin Docker. Al correr vía docker-compose/Kubernetes estas mismas variables
# ya se inyectan por environment/Secret, este archivo no hace falta ahí.

# ===== Servidor =====
NODE_ENV=development
PORT=3002

# ===== Base de datos: Supabase (ver ../../.env.example en la raíz) =====
DB_HOST=aws-1-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.wxjxviqtqyrzflxaidur
DB_PASSWORD=reemplaza-esto-por-el-password-real-de-supabase
DB_NAME=asignacion_db

# ===== Microservicios integrados =====
VEHICLE_SERVICE_URL=http://localhost:3000
USER_SERVICE_URL=http://localhost:3001
ZONE_SERVICE_URL=http://localhost:8080

# ===== RabbitMQ (auditoría) =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EXCHANGE=audit_exchange
RABBITMQ_ROUTING_KEY=audit.event

# ===== Logging =====
LOG_LEVEL=debug

# JWT_SECRET es obligatorio (no opcional): las llamadas a personas/vehiculos/
# zonas exigen un token válido firmado con el mismo secreto compartido.
JWT_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio-min-32-bytes
JWT_EXPIRATION=24h
